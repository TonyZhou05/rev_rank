# Copy to .env. All credentials stay on the FastAPI server.
# The app works with pasted text and synthetic examples without external keys.

# Live fetching is opt-in. Configure exact domains only after reviewing access rights.
REVRANK_LIVE_FETCH_ENABLED=false
REVRANK_ALLOWED_DOMAINS=
# US shopping-source test profile (opt in by setting live fetching true and copying
# this list above). Configuration enables attempts, not successful extraction or a
# reuse license. Robots/access/network checks still apply. See docs/source-tests/.
# www.carmax.com,carmax.com,www.carvana.com,carvana.com,www.cargurus.com,cargurus.com,www.cars.com,cars.com,www.autotrader.com,autotrader.com,www.carfax.com,carfax.com,www.truecar.com,truecar.com,www.edmunds.com,edmunds.com,www.kbb.com,kbb.com,www.autolist.com,autolist.com

# Optional OpenAI-compatible chat completions endpoint for extraction and analysis.
# Search recovery after blocked/incomplete imports. Choose brave or tavily.
# A search provider key is separate from the optional LLM key. Blank disables it.
REVRANK_SEARCH_PROVIDER=brave
REVRANK_SEARCH_API_KEY=

# Set both the model and API key to enable. Blank settings use explicit rules mode: deterministic
# extraction, comparison, constraint parsing and the constraint-fit shortlist all still work.
# DeepSeek is the configured provider; the endpoint is OpenAI-compatible, so any compatible base
# URL and model also work. deepseek-flash (DeepSeek-V4.1-Flash) supports tool calls and JSON output.
# Keep the key server-side. It is never sent to the browser and never logged.
REVRANK_LLM_API_KEY=
REVRANK_LLM_BASE_URL=https://api.deepseek.com/v1
REVRANK_LLM_MODEL=deepseek-flash

# Local private report storage. Do not expose this unauthenticated prototype publicly.
REVRANK_DATA_DIR=.local

# Optional licensed inventory (MarketCheck). Used first for recovery after a blocked
# import: looks up the listing URL, seller stock number, and VIN; returns dated records.
# Verify display/storage rights with the vendor. Blank disables it.
REVRANK_MARKETCHECK_API_KEY=

# MarketCheck NeoVIN decode of a known VIN, for the factory MSRP a listing cannot supply
# (oem_msrp, else original_msrp, else combined_msrp). One extra MarketCheck call per VIN;
# set to false to keep imports at the inventory lookups only.
REVRANK_NEOVIN_ENABLED=true

# MarketCheck past-inventory lookup (/v2/search/car/recents, expired listings from the last 90
# days), scoped to the pasted listing's own website. One extra call, spent only after every active
# lookup came back empty, so it runs on imports that would otherwise recover nothing. Its rows are
# dated history: they bind the VIN but never supply a current price or mileage. Set to false to
# stop at active inventory.
REVRANK_MARKETCHECK_PAST_INVENTORY_ENABLED=true

# Monthly caps enforced before each paid call (counts in .local/usage.json). MarketCheck's
# free tier is 500 calls; Tavily bills 2 credits per advanced search.
REVRANK_MARKETCHECK_MONTHLY_CALLS=500
REVRANK_SEARCH_MONTHLY_CREDITS=1000

# Hard limit for one POST /api/compare, deterministic comparison plus optional model work.
# Keep it under the page's own 90s compare limit so the buyer gets the deterministic report
# instead of a browser timeout. A cancelled or timed-out compare never invents analysis.
REVRANK_COMPARE_TIMEOUT_SECONDS=85

# After Direct is blocked, failed, or thin: open only the buyer-supplied listing URL
# in a private headless Chromium session first, extract listing fields, then fall
# through to MarketCheck/search if browse misses. Not a crawler or bypass.
# Settings default false. Docker/Render may set true (Tongli inspect path); production
# flag-on is still Tongli opt-in. Not counsel clearance.
REVRANK_BROWSER_RECOVERY_ENABLED=false
# Cap for one Playwright session. The import token (below) is the outer wall.
REVRANK_BROWSER_TIMEOUT_SECONDS=20
# Hard limit for one POST /api/import, Direct plus licensed/browse/search recovery.
# Cancel and timeout use the same request-scoped token as compare.
REVRANK_IMPORT_TIMEOUT_SECONDS=55

# Optional NHTSA vPIC VIN decode (free public US government API, no key). Cross-checks
# recovered year/make/model and flags VIN check-digit errors. Sends only the VIN.
REVRANK_VIN_DECODE_ENABLED=false

# Search-derived dealer flags on the report: excerpts from public bodies (state attorney general,
# DMV, licensing board, consumer protection, FTC) and dated news articles about the selling dealer,
# read into at most 3 green and 3 red cited flags. Off by default because each report spends search
# credits on the seller rather than the car (Tavily: 2 credits per search, so 4 credits per dealer at
# the default of 2 searches). Review and complaint platforms are never read here — they stay as
# link-outs on the dealer card. No page is fetched and no dealer score is produced. Needs a search
# provider above; the LLM only interprets what search returned, and without it the excerpts are
# listed uninterpreted.
REVRANK_DEALER_SIGNALS_ENABLED=false
REVRANK_DEALER_SIGNAL_SEARCHES=2
